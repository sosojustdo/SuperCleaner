<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.superbooster.cleaning"
    android:versionCode="5"
    android:versionName="5" >

    <uses-sdk
        android:minSdkVersion="16"
        android:targetSdkVersion="27" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <uses-permission android:name="android.permission.GET_PACKAGE_SIZE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="27" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <supports-screens
        android:anyDensity="true"
        android:largeScreens="true"
        android:normalScreens="true"
        android:resizeable="true"
        android:smallScreens="true" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name="com.yunthink.supercleanmaster.base.BaseApplication"
        android:allowBackup="true"
        android:debuggable="true"
        android:hardwareAccelerated="true"
        android:icon="@drawable/app_icon"
        android:label="@string/app_name"
        android:theme="@style/MyAppTheme" >
        <activity
            android:name="com.yunthink.supercleanmaster.ui.SplishActivity"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/TranslateThemeFull" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.yunthink.supercleanmaster.ui.MainActivity"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/MyAppTheme" />
        <activity
            android:name="com.yunthink.supercleanmaster.ui.ShortCutActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/short_cut_name"
            android:screenOrientation="portrait"
            android:taskAffinity="com.souapp.screenlockmanager"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" >
            <intent-filter>
                <action android:name="com.yzy.shortcut" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.yunthink.supercleanmaster.ui.MemoryCleanActivity"
            android:label="@string/app_memory_clean"
            android:screenOrientation="portrait"
            android:theme="@style/MyTranslucentAppTheme" />
        <activity
            android:name="com.yunthink.supercleanmaster.ui.RubbishCleanActivity"
            android:label="@string/app_rublish_clean"
            android:screenOrientation="portrait"
            android:theme="@style/MyTranslucentAppTheme" />
        <activity
            android:name="com.yunthink.supercleanmaster.ui.AutoStartManageActivity"
            android:label="@string/app_autostart_manage"
            android:screenOrientation="portrait"
            android:theme="@style/MyTranslucentAppTheme" />
        <activity
            android:name="com.yunthink.supercleanmaster.ui.SoftwareManageActivity"
            android:label="@string/app_software_manage"
            android:screenOrientation="portrait"
            android:theme="@style/MyTranslucentAppTheme" />
        <activity
            android:name="com.yunthink.supercleanmaster.base.FragmentContainerActivity"
            android:screenOrientation="portrait"
            android:theme="@style/MyTranslucentAppTheme" />
        <activity
            android:name="com.yunthink.supercleanmaster.ui.AboutActivity"
            android:screenOrientation="portrait"
            android:theme="@style/MyTranslucentAppTheme" />
        <activity
            android:name="com.yunthink.supercleanmaster.ui.CpucoolingActivity"
            android:label="@string/cpucool"
            android:screenOrientation="portrait"
            android:theme="@style/MyTranslucentAppTheme" />
        <activity
            android:name="com.yunthink.supercleanmaster.ui.BatteryActivity"
            android:label="@string/phone_save_electricity"
            android:screenOrientation="portrait"
            android:theme="@style/MyTranslucentAppTheme" />
        <activity
            android:name="com.yunthink.supercleanmaster.ui.PrivacypolicyActivity"
            android:label="@string/settings_privacypolicy"
            android:screenOrientation="portrait"
            android:theme="@style/MyTranslucentAppTheme" />
        <activity
            android:name="com.yunthink.supercleanmaster.ui.TermsofuseActivity"
            android:label="@string/settings_termsofuse"
            android:screenOrientation="portrait"
            android:theme="@style/MyTranslucentAppTheme" />
        <activity
            android:name="com.yunthink.supercleanmaster.ui.SendEmailActivity"
            android:label="@string/settings_sendemail"
            android:screenOrientation="portrait"
            android:theme="@style/MyTranslucentAppTheme" />

        <!-- ads activity -->
        <activity
            android:name="com.yunthink.supercleanmaster.ads.AdvertisementActivity"
            android:hardwareAccelerated="true"
            android:label="@string/advertising"
            android:screenOrientation="portrait"
            android:theme="@style/MyTranslucentAppTheme" />
        <activity
            android:name="com.yunthink.supercleanmaster.ads.AdvertisementActivity2"
            android:hardwareAccelerated="true"
            android:label="@string/advertising"
            android:screenOrientation="portrait"
            android:theme="@style/MyTranslucentAppTheme" />
        <activity
            android:name="com.yunthink.supercleanmaster.ads.AdvertisementActivity3"
            android:hardwareAccelerated="true"
            android:label="@string/advertising"
            android:screenOrientation="portrait"
            android:theme="@style/MyTranslucentAppTheme" />
        <activity
            android:name="com.yunthink.supercleanmaster.ads.AdvertisementActivity4"
            android:hardwareAccelerated="true"
            android:label="@string/advertising"
            android:screenOrientation="portrait"
            android:theme="@style/MyTranslucentAppTheme" />

        <service
            android:name="com.yunthink.supercleanmaster.service.PeripheralService"
            android:exported="false" />
        <service
            android:name="com.yunthink.supercleanmaster.service.CleanerService"
            android:exported="false" />
        <service
            android:name="com.yunthink.supercleanmaster.service.CoreService"
            android:exported="false" />

        <receiver android:name="com.yunthink.supercleanmaster.receiver.BootCompleteReceiver" >
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- ads sdk info -->
        <meta-data
            android:name="applovin.sdk.key"
            android:value="@string/applovin_sdk_key" />
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_app_id" />
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id" />

        <activity
            android:name="com.applovin.adview.AppLovinInterstitialActivity"
            android:configChanges="orientation|screenSize" />
        <activity
            android:name="com.applovin.adview.AppLovinConfirmationActivity"
            android:configChanges="orientation|screenSize" />
        <activity android:name="com.nhaarman.listviewanimations.itemmanipulation.swipedismiss.SwipeTouchListenerTestActivity" />
        <activity android:name="com.nhaarman.listviewanimations.itemmanipulation.dragdrop.DynamicListViewTestActivity" />
        <activity
            android:name="com.mylhyl.acp.AcpActivity"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Transparent" />
        <activity
            android:name="com.facebook.ads.AudienceNetworkActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name="com.facebook.ads.internal.ipc.RemoteANActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:process=":adnw"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name="com.facebook.ads.internal.ipc.AdsProcessPriorityService"
            android:exported="false" />
        <service
            android:name="com.facebook.ads.internal.ipc.AdsMessengerService"
            android:exported="false"
            android:process=":adnw" />

        <meta-data
            android:name="android.support.VERSION"
            android:value="26.1.0" />

        <activity
            android:name="com.applovin.sdk.AppLovinWebViewActivity"
            android:configChanges="keyboardHidden|orientation|screenSize" /> <!-- Include the AdActivity and InAppPurchaseActivity configChanges and themes. -->
        <activity
            android:name="com.google.android.gms.ads.AdActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent" />

        <provider
            android:name="com.google.android.gms.ads.MobileAdsInitProvider"
            android:authorities="com.superbooster.cleaning.mobileadsinitprovider"
            android:exported="false"
            android:initOrder="100" />

        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />
    </application>

</manifest>